static var _defs: Dictionary = {}
static var _by_file: Dictionary = {}

static func get_def(type: int) -> Defs.ReanimDef:
	if not _defs.has(type):
		_defs[type] = Defs.load_reanim(files[type])
	return _defs[type]

static func type_from_file(path: String) -> int:
	if _by_file.is_empty():
		for i in files.size():
			_by_file[files[i].to_lower()] = i
	return _by_file.get(path.replace("\\", "/").to_lower(), -1)

## Registers a new reanim file (for custom content) and returns its type id.
static func register(path: String) -> int:
	var t := type_from_file(path)
	if t != -1:
		return t
	files.append(path)
	_by_file[path.to_lower()] = files.size() - 1
	return files.size() - 1

## Registers an already-parsed definition under a synthetic name and returns its type id.
## Custom levels use this for reanims loaded from user:// that have no res:// path.
static func register_def(name: String, def: Defs.ReanimDef) -> int:
	var t := type_from_file(name)
	if t != -1:
		_defs[t] = def
		return t
	files.append(name)
	var idx := files.size() - 1
	_by_file[name.to_lower()] = idx
	_defs[idx] = def
	return idx

## Drops every type registered past [param count] (used when a custom level is unloaded).
static func truncate(count: int) -> void:
	if count < 0 or count >= files.size():
		return
	for i in range(count, files.size()):
		_by_file.erase(String(files[i]).to_lower())
		_defs.erase(i)
	files.resize(count)
